{
  "name": "@rodrigofranca/ultra-media",
  "version": "0.0.3",
  "description": "",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ultra-media.es.js",
      "require": "./dist/ultra-media.umd.cjs"
    },
    "./ad": {
      "types": "./dist/ad.d.ts",
      "import": "./dist/ultra-media-ad.es.js",
      "require": "./dist/ultra-media-ad.umd.cjs"
    },
    "./core": {
      "types": "./dist/core-entry.d.ts",
      "import": "./dist/ultra-media-core.es.js",
      "require": "./dist/ultra-media-core.umd.cjs"
    }
  },
  "main": "./dist/ultra-media.umd.cjs",
  "unpkg": "./dist/ultra-media.umd.js",
  "jsdelivr": "./dist/ultra-media.umd.js",
  "module": "./dist/ultra-media.es.js",
  "files": [
    "dist",
    "types",
    "vscode.html-data.json"
  ],
  "types": "types/global.d.ts",
  "customElements": "custom-elements.json",
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "dev": "vite",
    "build": "vite build && BUILD_ENTRY=ad vite build && BUILD_ENTRY=core vite build && node scripts/copy-umd-for-browsers.mjs",
    "watch": "vite build --watch",
    "preview": "vite preview",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/check-bundle-isolation.mjs && node scripts/check-core-isolation.mjs && size-limit",
    "analyze": "cem analyze",
    "analyze:bundle": "source-map-explorer dist/ultra-media.es.js --gzip --no-border-checks",
    "e2e": "pnpm run build && playwright test --config=e2e/playwright.config.ts",
    "e2e:network": "pnpm run build && E2E_NETWORK=1 playwright test --config=e2e/playwright.config.ts",
    "serve:examples": "wet serve --cors --livereload --redirect :examples/ --log-level error"
  },
  "size-limit": [
    {
      "name": "core ESM bundle (gzip)",
      "path": "dist/ultra-media.es.js",
      "gzip": true,
      "limit": "19 KB"
    },
    {
      "name": "core UMD bundle (gzip)",
      "path": "dist/ultra-media.umd.cjs",
      "gzip": true,
      "limit": "13.5 KB"
    },
    {
      "name": "ads ESM bundle (gzip)",
      "path": "dist/ultra-media-ad.es.js",
      "gzip": true,
      "limit": "25.1 KB"
    },
    {
      "name": "ads UMD bundle (gzip)",
      "path": "dist/ultra-media-ad.umd.cjs",
      "gzip": true,
      "limit": "21 KB"
    },
    {
      "name": "headless core ESM bundle (gzip)",
      "path": "dist/ultra-media-core.es.js",
      "gzip": true,
      "limit": "13.5 KB"
    },
    {
      "name": "headless core UMD bundle (gzip)",
      "path": "dist/ultra-media-core.umd.cjs",
      "gzip": true,
      "limit": "10 KB"
    }
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.10.4",
    "@jest/globals": "30.0.0-beta.3",
    "@playwright/test": "^1.63.0",
    "@rollup/plugin-replace": "^6.0.2",
    "@size-limit/file": "^14.0.0",
    "@types/jest": "^29.5.14",
    "cem-plugin-vs-code-custom-data-generator": "^1.4.2",
    "dashjs": "5.2.1",
    "ffmpeg-static": "^5.3.0",
    "hls.js": "1.7.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^26.1.0",
    "media-chrome": "4.19.2",
    "size-limit": "^14.0.0",
    "source-map-explorer": "^2.5.3",
    "ts-jest": "^29.3.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-mkcert": "^1.17.8",
    "wet-run": "^1.2.5"
  },
  "dependencies": {
    "custom-media-element": "^1.4.6",
    "ima-ad-player": "^0.5.7",
    "media-tracks": "^0.3.4"
  }
}
