{
  "name": "@rodrigofranca/ultra-media",
  "version": "0.0.3",
  "description": "",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ultra-media.es.js",
      "require": "./dist/ultra-media.umd.js"
    },
    "./ad": {
      "types": "./dist/ad.d.ts",
      "import": "./dist/ultra-media-ad.es.js",
      "require": "./dist/ultra-media-ad.umd.js"
    }
  },
  "main": "./dist/ultra-media.umd.js",
  "module": "./dist/ultra-media.es.js",
  "files": [
    "dist",
    "types",
    "vscode.html-data.json"
  ],
  "types": "types/global.d.ts",
  "customElements": "custom-elements.json",
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "dev": "vite",
    "build": "vite build && BUILD_ENTRY=ad vite build",
    "watch": "vite build --watch",
    "preview": "vite preview",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "analyze": "cem analyze",
    "e2e": "pnpm run build && playwright test --config=e2e/playwright.config.ts",
    "e2e:network": "pnpm run build && E2E_NETWORK=1 playwright test --config=e2e/playwright.config.ts",
    "serve:examples": "wet serve --cors --livereload --redirect :examples/ --log-level error"
  },
  "size-limit": [
    {
      "name": "ESM bundle (gzip)",
      "path": "dist/ultra-media.es.js",
      "gzip": true,
      "limit": "35.6 KB"
    },
    {
      "name": "UMD bundle (gzip)",
      "path": "dist/ultra-media.umd.js",
      "gzip": true,
      "limit": "30.2 KB"
    }
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.10.4",
    "@jest/globals": "30.0.0-beta.3",
    "@playwright/test": "^1.63.0",
    "@rollup/plugin-replace": "^6.0.2",
    "@size-limit/file": "^14.0.0",
    "@types/jest": "^29.5.14",
    "cem-plugin-vs-code-custom-data-generator": "^1.4.2",
    "dashjs": "5.2.1",
    "ffmpeg-static": "^5.3.0",
    "hls.js": "1.7.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^26.1.0",
    "size-limit": "^14.0.0",
    "ts-jest": "^29.3.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-mkcert": "^1.17.8",
    "wet-run": "^1.2.5"
  },
  "dependencies": {
    "ima-ad-player": "^0.5.7",
    "media-tracks": "^0.3.4",
    "super-media-element": "^1.4.2"
  }
}
